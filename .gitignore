# --- python (anime/api) ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# --- node (anime/site) ---
node_modules/
dist/
.vite/

# --- runtime user data (watch history / favorites) ---
server/data/
data/

# --- tooling / secrets ---
.vercel/
.env
*.log
.env*
# exception: production env is public (VITE_* values are inlined into the
# JS bundle anyway) and the deployed site needs the API base baked in
!site/.env.production
